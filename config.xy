"""
AfriMarket — Configuration centrale
"""
import os
from dotenv import load_dotenv

load_dotenv()

class Settings:
    # App
    APP_NAME: str = "AfriMarket"
    APP_URL: str = os.getenv("APP_URL", "http://localhost:8000")
    DEBUG: bool = os.getenv("DEBUG", "False").lower() == "true"

    # Supabase
    SUPABASE_URL: str = os.getenv("SUPABASE_URL", "")
    SUPABASE_ANON_KEY: str = os.getenv("SUPABASE_ANON_KEY", "")
    SUPABASE_SERVICE_KEY: str = os.getenv("SUPABASE_SERVICE_KEY", "")

    # Sécurité JWT
    SECRET_KEY: str = os.getenv("SECRET_KEY", "change_me_in_production_please")
    ALGORITHM: str = "HS256"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 60

    # CORS
    ALLOWED_ORIGINS: list = os.getenv(
        "ALLOWED_ORIGINS",
        "http://localhost:8000,http://localhost:3000"
    ).split(",")

    # LeekPay
    LEEKPAY_PUBLIC_KEY: str = os.getenv("LEEKPAY_PUBLIC_KEY", "")
    LEEKPAY_SECRET_KEY: str = os.getenv("LEEKPAY_SECRET_KEY", "")

    # Rate limiting
    RATE_LIMIT_PER_MINUTE: int = 60
    RATE_LIMIT_AUTH: int = 10  # plus strict sur les routes auth

settings = Settings()

